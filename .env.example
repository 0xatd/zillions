# Copy to .env.local (never commit real values) or set these in the Vercel
# project settings. Every value below is a placeholder.

# Supabase project (browser-safe; served by api/auth-config.js).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are accepted aliases.

# Server only. Used by api/economy.js and api/match-result.js to call the
# service-role RPCs that grant XP, loot, Alloy and stats. Never expose it to
# the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only, required for rewards. HMAC key for match tickets issued by
# api/match-start.js and checked by api/match-result.js. At least 32 random
# characters (e.g. `openssl rand -base64 48`). Rotating it voids every
# unspent ticket. Without it both endpoints answer 503 and no match pays out.
MATCH_TICKET_SECRET=replace-with-at-least-32-random-characters

# Optional. JSON array of extra WebRTC ICE servers for co-op, e.g.
# [{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
WEBRTC_ICE_SERVERS=

# Optional, scripts only: where browser visual QA writes screenshots.
ZILLIONS_VISUAL_QA_DIR=
