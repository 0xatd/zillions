{
  "functions": {
    "api/living-world-worker.js": { "maxDuration": 60 },
    "api/living-world-health-monitor.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/living-world-worker", "schedule": "* * * * *" },
    { "path": "/api/living-world-health-monitor", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/(assets|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/heroes/portraits/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
